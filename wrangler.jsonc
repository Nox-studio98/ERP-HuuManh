{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huu-manh-erp",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/img/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "huu-manh-erp",
      "database_id": "01557b74-7189-49a6-adf5-9591ec6bb3ba",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "huu-manh-erp-files" }],
  "triggers": { "crons": ["0 17 * * *", "*/30 * * * *", "*/5 * * * *", "0 1 * * *"] },
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "huu-manh-erp-jobs" }],
    "consumers": [{ "queue": "huu-manh-erp-jobs", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "huu-manh-erp-jobs-dlq" }]
  },
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "2101", "simple": { "limit": 10, "period": 60 } },
    { "name": "RATE_LIMITER", "namespace_id": "2102", "simple": { "limit": 300, "period": 60 } }
  ],
  "vars": { "APP_ENV": "production" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "workers_dev": true,
  "env": {
    // Bản demo gửi khách trên *.workers.dev. Không khai báo Queues (cần gói trả phí) —
    // job tích hợp được cron "*/5" xử lý trực tiếp (services/jobs.ts sweepJobs).
    "demo": {
      "name": "huu-manh-erp-demo",
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "2103", "simple": { "limit": 10, "period": 60 } },
        { "name": "RATE_LIMITER", "namespace_id": "2104", "simple": { "limit": 300, "period": 60 } }
      ],
      // Tên miền riêng cho bản demo (zone noxelis.co trong cùng account) — wrangler tự tạo DNS + chứng chỉ
      "routes": [{ "pattern": "huumanh.noxelis.co", "custom_domain": true }],
      "vars": { "APP_ENV": "demo", "SHOP_BASE_URL": "https://huumanhfruit.noxelis.co" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "huu-manh-erp",
          "database_id": "01557b74-7189-49a6-adf5-9591ec6bb3ba",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "huu-manh-erp-files" }]
    },
    "staging": {
      "name": "huu-manh-erp-staging",
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "2105", "simple": { "limit": 10, "period": 60 } },
        { "name": "RATE_LIMITER", "namespace_id": "2106", "simple": { "limit": 300, "period": 60 } }
      ],
      "vars": { "APP_ENV": "staging" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "huu-manh-erp-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "huu-manh-erp-files-staging" }],
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "huu-manh-erp-jobs-staging" }],
        "consumers": [{ "queue": "huu-manh-erp-jobs-staging", "max_batch_size": 10, "max_retries": 5, "dead_letter_queue": "huu-manh-erp-jobs-staging-dlq" }]
      }
    }
  }
}
