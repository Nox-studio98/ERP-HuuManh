{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Website + app bán hàng cho khách (M8). Worker công khai, TÁCH khỏi ERP nội bộ; dùng chung D1/R2/Queue.
  "name": "huu-manh-shop",
  "main": "src/shop/worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist-shop/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/img/*", "/sitemap.xml", "/robots.txt"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "huu-manh-erp",
      "database_id": "01557b74-7189-49a6-adf5-9591ec6bb3ba",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "huu-manh-erp-files" }],
  "queues": { "producers": [{ "binding": "JOBS", "queue": "huu-manh-erp-jobs" }] },
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "2201", "simple": { "limit": 10, "period": 60 } },
    { "name": "RATE_LIMITER", "namespace_id": "2202", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_CHECKOUT", "namespace_id": "2207", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": { "APP_ENV": "production" },
  "observability": { "enabled": true },
  "workers_dev": true,
  "env": {
    // Bản demo gửi khách (*.workers.dev). TURNSTILE_SECRET là KHOÁ THỬ NGHIỆM CÔNG KHAI của Cloudflare
    // (luôn cho qua) — CHỈ dùng cho demo, phải thay bằng secret thật trước khi go-live.
    "demo": {
      "name": "huu-manh-shop-demo",
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "2203", "simple": { "limit": 10, "period": 60 } },
        { "name": "RATE_LIMITER", "namespace_id": "2204", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_CHECKOUT", "namespace_id": "2208", "simple": { "limit": 20, "period": 60 } }
      ],
      "routes": [{ "pattern": "huumanhfruit.noxelis.co", "custom_domain": true }],
      "vars": { "APP_ENV": "demo", "TURNSTILE_SECRET": "1x0000000000000000000000000000000AA", "SHOP_BASE_URL": "https://huumanhfruit.noxelis.co" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "huu-manh-erp",
          "database_id": "01557b74-7189-49a6-adf5-9591ec6bb3ba",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "huu-manh-erp-files" }]
    },
    // Staging: D1/R2/Queue RIÊNG của staging — tuyệt đối không trỏ vào dữ liệu production
    "staging": {
      "name": "huu-manh-shop-staging",
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "2205", "simple": { "limit": 10, "period": 60 } },
        { "name": "RATE_LIMITER", "namespace_id": "2206", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_CHECKOUT", "namespace_id": "2209", "simple": { "limit": 20, "period": 60 } }
      ],
      "vars": { "APP_ENV": "staging" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "huu-manh-erp-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "huu-manh-erp-files-staging" }],
      "queues": { "producers": [{ "binding": "JOBS", "queue": "huu-manh-erp-jobs-staging" }] }
    }
  }
}
